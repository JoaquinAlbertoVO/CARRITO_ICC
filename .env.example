# Copia este archivo como .env en el servidor (public_html/.env) y completa los valores.
# El .env nunca se sube al repositorio ni lo copia el despliegue.

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# Token de verificacion de Hotmart (Herramientas > Webhook > hottok). Sin el, el webhook rechaza todo
HOTMART_HOTTOK=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live

# Culqi (tarjeta en soles en el checkout de ST Energy). CulqiPanel > Desarrollo > API Keys.
# Llaves de integracion pk_test_/sk_test_ para probar; sin CULQI_PUBLIC_KEY la opcion no aparece.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

STENERGY_API_URL=
STENERGY_API_SECRET=

SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# Token del script de lotes para dar de alta certificados en /verificar
CERT_REGISTRO_TOKEN=
# Datos de ST Energy en la verificacion de sus certificados
ST_RUC=
ST_RAZON_SOCIAL=
# Link del grupo de WhatsApp del curso de electricidad con IA
GRUPO_WSP_ELECTRICIDAD_IA=
# Opcional: habilita el pago de prueba de US$ 0.10 con ?prueba=<clave>
PRUEBA_PAGO_CLAVE=
